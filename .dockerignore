# Source-control metadata and CI files are not needed inside the Docker build context.
.git
.github
**/__pycache__
**/*.pyc
**/.DS_Store

# Previous download/update archives must not be sent to the builder.
*.zip
**/*.zip
*.tar
*.tar.gz
*.tar.zst
**/*.tar.gz
**/*.tar.zst

# Weights are downloaded at Pod startup, NOT baked into this image.
**/*.safetensors
**/*.gguf
**/*.ckpt
**/*.pt
**/*.pth
/models
/input
/output
/outputs
/workspace
/ComfyUI
/ollama

# Local Python environments and credentials are not part of the source recipe.
.venv
venv
**/.venv
**/venv
.env
.env.*
!.env.example
