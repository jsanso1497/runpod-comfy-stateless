  "12": {
    "class_type": "BasicScheduler",
    "inputs": {
      "scheduler": "simple",
      "steps": 50,
      "denoise": 1.0,
      "model": [
        "8",
        0
      ]
    },
    "_meta": {
      "title": "50 steps - simple - denoise 1 - NO Turbo LoRA"
    }
  },
  "13": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "10",
        0
      ],
      "guider": [
        "9",
        0
      ],
      "sampler": [
        "11",
        0
      ],
      "sigmas": [
        "12",
        0
      ],
      "latent_image": [
        "7",
        0
      ]
