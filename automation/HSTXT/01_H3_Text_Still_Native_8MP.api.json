      "prompt": "A realistic editorial photograph of a person seated beside a large window in a quiet modern studio, natural side lighting, coherent anatomy, expressive eyes, realistic skin texture, detailed hair and woven fabric, restrained color grading, balanced composition, subtle depth of field. One photographic still. No collage, captions or graphic overlays.",
      "width": [
        "5",
        0
      ],
      "height": [
        "5",
        1
      ],
      "length": 5,
      "clip": [
        "2",
        0
      ],
      "vae": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "3. Edit prompt - CONDITIONING only, leave its LATENT unused"
    }
  },
  "7": {
    "class_type": "FizgigH3StillLatent",
    "inputs": {
      "width": [
        "5",
        0
      ],
      "height": [
        "5",
        1
      ],
      "batch_size": 1
    },
    "_meta": {
      "title": "4. TRUE SINGLE FRAME - batch 1"
    }
  },
  "8": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "shift_video": 12.0,
      "shift_audio": 3.0,
      "model": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Native shifts - 12 video / 3 audio"
    }
  },
  "9": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "8",
        0
