{
  "1": {
    "class_type": "WBH3LoadNativeMaster",
    "inputs": {
      "master_file": "Select a native H3 MKV master after generation"
    },
    "_meta": {
      "title": "1. Select APPROVED NATIVE MKV - not MP4 / 4K"
    }
  },
  "2": {
    "class_type": "WBH3ReleaseMemory",
    "inputs": {
      "images": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "2. Offload H3 before loading SeedVR2"
    }
  },
  "3": {
    "class_type": "SeedVR2LoadDiTModel",
    "inputs": {
      "model": "seedvr2_ema_7b_fp16.safetensors",
      "device": "cuda:0",
      "blocks_to_swap": 0,
      "swap_io_components": false,
      "offload_device": "cpu",
      "cache_model": false,
      "attention_mode": "sdpa"
    },
    "_meta": {
      "title": "Full 7B FP16 - no sharp / FP8 model"
    }
  },
  "4": {
    "class_type": "SeedVR2LoadVAEModel",
    "inputs": {
      "model": "ema_vae_fp16.safetensors",
      "device": "cuda:0",
      "encode_tiled": true,
      "encode_tile_size": 1024,
      "encode_tile_overlap": 128,
      "decode_tiled": true,
      "decode_tile_size": 1024,
      "decode_tile_overlap": 128,
      "tile_debug": "false",
      "offload_device": "cpu",
      "cache_model": false
    },
    "_meta": {
      "title": "Full FP16 VAE - tiled decode"
    }
  },
  "5": {
    "class_type": "SeedVR2VideoUpscaler",
    "inputs": {
      "seed": 42,
      "resolution": 2160,
      "max_resolution": 3840,
      "batch_size": 9,
      "uniform_batch_size": true,
      "temporal_overlap": 4,
      "prepend_frames": 4,
      "color_correction": "lab",
      "input_noise_scale": 0.0,
      "latent_noise_scale": 0.0,
      "offload_device": "cpu",
      "enable_debug": false,
      "image": [
        "2",
        0
      ],
      "dit": [
        "3",
        0
      ],
      "vae": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "3. 4K-CLASS FINISH - zero added noise"
    }
  },
  "6": {
    "class_type": "WBH3LosslessMaster",
    "inputs": {
      "fps": [
        "1",
        2
      ],
      "filename_prefix": "video/H3_First_Last/4k/H3_4K_finish",
      "images": [
        "5",
        0
      ],
      "audio": [
        "1",
        1
      ]
    },
    "_meta": {
      "title": "4. Save separate RGB16 upscaled master"
    }
  },
  "7": {
    "class_type": "CreateVideo",
    "inputs": {
      "fps": [
        "1",
        2
      ],
      "bit_depth": 8,
      "color_space": "sRGB",
      "codec": "none",
      "images": [
        "6",
        0
      ],
      "audio": [
        "1",
        1
      ]
    },
    "_meta": {
      "title": "Keep original audio and frame rate"
    }
  },
  "8": {
    "class_type": "SaveVideo",
    "inputs": {
      "filename_prefix": "video/H3_First_Last/previews/H3_4K_finish",
      "format": "mp4",
      "format.codec": "auto",
      "video": [
        "7",
        0
      ]
    },
    "_meta": {
      "title": "4K-class MP4 preview - master is saved separately"
    }
  }
}
