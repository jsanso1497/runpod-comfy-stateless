# LITE template. Keep existing secret names when they differ.
OLLAMA_MODEL=huihui_ai/qwen3-vl-abliterated:8b-instruct-q4_K_M
ASSET_DOWNLOAD_WORKERS=2
HF_TOKEN={{ RUNPOD_SECRET_huggingface_token }}
CIVITAI_TOKEN={{ RUNPOD_SECRET_civitai_token }}
FILEBROWSER_PORT=8888
FILEBROWSER_PASSWORD={{ RUNPOD_SECRET_filebrowser_password }}

# Optional Krea 2 still-image workflow; separate BF16 weights, not the H3 model.
# Both flags are opt-in. Allow additional disk before enabling.
ENABLE_KREA_IDENTITY=0
KREA_IDENTITY_UPSCALE=0

# Optional HQ MP4 voice / identity / action references.
# Always FULL BF16 H3, even in Lite; additional downloads unless already present.
ENABLE_H3_MEDIA=0
