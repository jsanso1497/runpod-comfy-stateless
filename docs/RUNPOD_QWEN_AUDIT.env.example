# Enter these as individual key/value rows in a RunPod template.
# Comments are not rows. Secret placeholders resolve in RunPod, not Mac Terminal.
WB_WORKSPACE=qwen
WB_TASKS=SQ,Q01,QNATIVE,QOVERLAY,QDEV,QGS1,QKEEP1,QMOSS,QMOSS_I2I
WB_TOOLBOX=sam,seedvr2,qwen_stock_pe,qwen_pe_i2i
WB_AUTH_MODE=basic
WB_PASSWORD={{ RUNPOD_SECRET_comfy_password }}
HF_TOKEN={{ RUNPOD_SECRET_hf_token }}
CIVITAI_TOKEN={{ RUNPOD_SECRET_civit_token }}
WB_LORA_URLS={{ RUNPOD_SECRET_comfy_loras }}
WB_CHECKPOINTS={{ RUNPOD_SECRET_comfy_checkpoints }}
WB_QWEN_PROMPT_MODEL=huihui_ai/Qwen3.8-abliterated:27b-bf16
WB_QWEN_PROMPT_FAILURE=original
WB_DATA_ROOT=/workspace
WB_DISABLE_COMFY_COMPILER=1
WB_SAVE_METADATA=0
WB_CUDA_COMPAT=auto
WB_MOSS_AUTO_PREPARE=1

# Omit a private-library row when that secret does not exist.
# Existing Qwen workflows remain available; these tasks select startup assets.
# MOSS auto preparation adds the shared model group even with an older task list.
# To opt out of automatic MOSS downloads, use WB_MOSS_AUTO_PREPARE=0 and remove
# QMOSS/QMOSS_I2I from WB_TASKS and moss_image from WB_TOOLBOX, if present.
