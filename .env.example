# TEMPLATE REFERENCE ONLY. These placeholders are resolved by RunPod, not your shell.
# Prefer the configurator. Ordinary workflow changes do not require environment edits.

# 1. TEMPLATE DEFAULTS
WB_WORKSPACE=qwen
WB_TASKS=SQ,Q01
WB_TOOLBOX=

# 2. EXISTING PROVIDER SECRETS
HF_TOKEN={{ RUNPOD_SECRET_hf_token }}
CIVITAI_TOKEN={{ RUNPOD_SECRET_civit_token }}

# 3. REQUIRED ACCESS SECRET: create once, 16+ characters
WB_PASSWORD={{ RUNPOD_SECRET_comfy_password }}

# 4. OPTIONAL PRIVATE LIBRARIES: create only when used
# WB_LORA_URLS={{ RUNPOD_SECRET_comfy_loras }}
# WB_CHECKPOINTS={{ RUNPOD_SECRET_comfy_checkpoints }}

# 5. ADVANCED OVERRIDES: normally untouched
# WB_DATA_ROOT=/workspace
# WB_LORA_FILE=/workspace/private/lora_links.txt
# WB_CHECKPOINT_FILE=/workspace/private/checkpoints.json
# WB_SAVE_METADATA=0
