# Required secrets. Enter in RunPod, never commit real credentials.
HF_TOKEN=hf_REPLACE_WITH_YOUR_READ_TOKEN
FILEBROWSER_PASSWORD=REPLACE_WITH_A_UNIQUE_12_PLUS_CHARACTER_PASSWORD

# Defaults. All inference stays on your selected Pod GPU.
FLUX_PHOTO_DOWNLOAD_MODELS=1
SYNC_SHARED_LORAS=1
VRAM_MODE=auto
COMFY_REF=pinned
COMFY_HOME=/workspace/ComfyUI
COMFY_PORT=8188
FILEBROWSER_PORT=8888
COMFY_MAX_UPLOAD_MB=1024

# OPTIONAL: reload config/lora_links.txt from GitHub at startup.
# Not needed when using the copy bundled by the image build.
# CONFIG_REPO=https://github.com/YOUR_OWNER/YOUR_REPOSITORY
# CONFIG_REF=main
# GITHUB_TOKEN=YOUR_PRIVATE_REPOSITORY_READ_TOKEN
