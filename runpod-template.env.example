# GENERAL :latest template only. Full/Lite portrait variables are in START_HERE.md.
# Template ENVIRONMENT VARIABLES. Do not paste into the start-command field.
# Image: ghcr.io/jsanso1497/runpod-comfy-stateless:latest
# Container disk: 500 GB; volume: 0 GB; network volume: None; HTTP: 8188,8888.
# Start command: blank. Registry credential: GitHub GHCR.
COMFY_REF=pinned
MODEL_PROFILES=seedvr2,krea2,h3
ENABLE_OLLAMA=1
OLLAMA_MODEL=huihui_ai/qwen3-vl-abliterated:32b-instruct-fp16
ATTENTION_BACKEND=pytorch
VRAM_MODE=auto
ENABLE_DYNAMIC_VRAM=auto
ASSET_DOWNLOAD_WORKERS=2
# Keep existing HF_TOKEN and CIVITAI_TOKEN secret references unchanged.
# Remove CONFIG_REPO, CONFIG_REF, OLLAMA_MODEL_DIGEST and COMFY_ARGS if listed.
# Do not expose port 11434. No new API key is needed for the local helper.

FILEBROWSER_PORT=8888
FILEBROWSER_PASSWORD={{ RUNPOD_SECRET_filebrowser_password }}
HF_TOKEN={{ RUNPOD_SECRET_huggingface_token }}
CIVITAI_TOKEN={{ RUNPOD_SECRET_civitai_token }}

# Optional Krea 2 still-image workflow; separate BF16 weights, not the H3 model.
# Both flags are opt-in. Allow additional disk before enabling.
ENABLE_KREA_IDENTITY=0
KREA_IDENTITY_UPSCALE=0
