# Core
COMFY_REF=master
COMFY_PORT=8188
ATTENTION_BACKEND=auto
VRAM_MODE=auto
ENABLE_DYNAMIC_VRAM=auto
ASSET_DOWNLOAD_WORKERS=4

# Optional external config repo. Leave blank to use config baked into the image.
CONFIG_REPO=
CONFIG_REF=main

# Optional launch flags appended to ComfyUI.
COMFY_ARGS=

# Store these as RunPod Secrets, not plain template values.
HF_TOKEN=
CIVITAI_TOKEN=
GITHUB_TOKEN=
JUPYTER_TOKEN=
PUBLIC_KEY=
